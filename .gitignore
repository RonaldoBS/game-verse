# ==============================================================================
# Gameverse E-Commerce - .gitignore
# Arquivos sensíveis, variáveis de ambiente, caches e dependências locais
# ==============================================================================

# Variáveis de Ambiente e Credenciais Sensíveis (NUNCA comitar)
.env
.env.*
*.env
.env.local
.env.development.local
.env.test.local
.env.production.local
*.pem
*.key
*.cert
*.crt
*.pfx
*.p12
id_rsa*
secrets/
config.local.json

# Logs e Relatórios de Debug
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Dependências
node_modules/
jspm_packages/
.pnpm-store/

# Builds e Saídas de Compilação
dist/
build/
out/
.cache/
tmp/
temp/
*.tmp
*.bak

# Arquivos de IDE e Editores de Código
.vscode/
.idea/
*.sublime-project
*.sublime-workspace
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
.project
.settings/

# Arquivos do Sistema Operacional (Windows & macOS)
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
desktop.ini

# Jekyll / GitHub Pages (caso aplicável)
_site/
.sass-cache/
.jekyll-cache/
.jekyll-metadata
Gemfile.lock
